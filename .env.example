# --- AMI Unified Quant Workstation — environment template ---
# Copy this file to `.env` and fill in real values before running.

# SQLite database location (Prisma). The db/ folder is kept via .gitkeep;
# `bun run db:push` creates/updates the .db file.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# NextAuth v4 secret — generate your own with:  openssl rand -hex 24
NEXTAUTH_SECRET=replace-with-a-32-byte-hex-secret

# Canonical app URL. For local dev use http://localhost:3000.
# (The preview gateway path is detected automatically from the request host,
# so you do NOT need to change this for the preview panel to work.)
NEXTAUTH_URL=http://localhost:3000
