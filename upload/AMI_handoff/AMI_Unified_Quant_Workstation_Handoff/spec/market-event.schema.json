{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ami.local/schemas/market-event.schema.json",
  "title": "AMI Canonical Market Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "instrumentId",
    "venue",
    "source",
    "eventTime",
    "receiveTime",
    "ingestTime",
    "timestampUnit",
    "quality",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "enum": [
        "TRADE",
        "QUOTE",
        "BOOK_SNAPSHOT",
        "BOOK_DELTA",
        "CANDLE_UPDATE",
        "CLOSED_CANDLE",
        "SESSION_STATUS",
        "CONTRACT_METADATA"
      ]
    },
    "instrumentId": {
      "type": "string"
    },
    "venue": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "sourceEventId": {
      "type": [
        "string",
        "null"
      ]
    },
    "eventTime": {
      "type": "string",
      "format": "date-time"
    },
    "receiveTime": {
      "type": "string",
      "format": "date-time"
    },
    "ingestTime": {
      "type": "string",
      "format": "date-time"
    },
    "timestampUnit": {
      "const": "ISO8601_UTC"
    },
    "sequence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "schemaVersionSource": {
      "type": [
        "string",
        "null"
      ]
    },
    "quality": {
      "type": "object",
      "required": [
        "status",
        "flags"
      ],
      "properties": {
        "status": {
          "enum": [
            "VALID",
            "PARTIAL",
            "STALE",
            "INVALID",
            "UNVERIFIED"
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object"
    },
    "sourceReference": {
      "type": [
        "string",
        "null"
      ]
    },
    "snapshotId": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
