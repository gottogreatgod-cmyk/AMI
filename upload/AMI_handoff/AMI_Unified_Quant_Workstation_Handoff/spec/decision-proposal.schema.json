{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ami.local/schemas/decision-proposal.schema.json",
  "title": "AMI Decision Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposalId",
    "instrumentId",
    "strategyId",
    "strategyVersion",
    "asOf",
    "direction",
    "status",
    "evidenceIds",
    "invalidation",
    "expiry",
    "lineage"
  ],
  "properties": {
    "proposalId": {
      "type": "string"
    },
    "instrumentId": {
      "type": "string"
    },
    "contractId": {
      "type": [
        "string",
        "null"
      ]
    },
    "strategyId": {
      "type": "string"
    },
    "strategyVersion": {
      "type": "string"
    },
    "configHash": {
      "type": "string"
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "direction": {
      "enum": [
        "LONG",
        "SHORT",
        "FLAT",
        "WATCH"
      ]
    },
    "setup": {
      "type": "string"
    },
    "entry": {
      "type": [
        "object",
        "null"
      ]
    },
    "stop": {
      "type": [
        "object",
        "null"
      ]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "expectedGrossR": {
      "type": [
        "number",
        "null"
      ]
    },
    "expectedNetR": {
      "type": [
        "number",
        "null"
      ]
    },
    "confidence": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "UNCALIBRATED_SCORE",
            "CALIBRATED_PROBABILITY",
            "NONE"
          ]
        },
        "calibrationRef": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "status": {
      "enum": [
        "PROPOSED",
        "WATCH",
        "NO_TRADE",
        "RISK_REJECTED",
        "RISK_ELIGIBLE"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invalidation": {
      "type": "string"
    },
    "expiry": {
      "type": "string",
      "format": "date-time"
    },
    "lineage": {
      "type": "object",
      "required": [
        "marketSnapshotIds",
        "featureSnapshotIds",
        "fusionVersion"
      ],
      "properties": {
        "marketSnapshotIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "featureSnapshotIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modelRunIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fusionVersion": {
          "type": "string"
        }
      }
    }
  }
}